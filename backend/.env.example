# ============================================================
# Realty ERP — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit a .env with real secrets to version control.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_32_plus_char_hex_secret

# ----------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins.
# Example for production:
#   CORS_ORIGINS=https://app.mi-inmobiliaria.com,https://admin.mi-inmobiliaria.com
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Local backend + PostgreSQL from Compose. Compose overrides the host/port
# with db:5432 when the backend also runs inside Docker.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:55432/realty_erp

# Development over HTTP (use secure cookies with HTTPS in production).
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Optional: create the first superadmin on startup, after applying migrations.
# BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com

# ----------------------------------------------------------
# Optional JWT settings (defaults shown)
# ----------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
